{
  "name": "mashlab-ai-cyphablend-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test scripts/verify-core.mts",
    "sidecar:start": "node --experimental-strip-types scripts/sidecar-lifecycle.mts start",
    "sidecar:stop": "node --experimental-strip-types scripts/sidecar-lifecycle.mts stop",
    "sidecar:status": "node --experimental-strip-types scripts/sidecar-lifecycle.mts status",
    "sidecar:wsl:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-wsl-rhythm.ps1",
    "sidecar:wsl": "powershell -ExecutionPolicy Bypass -File scripts/run-wsl-sidecar.ps1",
    "sidecar:wsl:selftest": "node --experimental-strip-types scripts/rhythm-selftest-harness.mts",
    "sidecar:wsl:check": "node --experimental-strip-types scripts/wsl-sidecar-check.mts",
    "setup:windows:check": "node --experimental-strip-types scripts/windows-runtime-check.mts",
    "setup:windows:guide": "node --experimental-strip-types scripts/windows-runtime-guide.mts",
    "setup:windows:check:strict": "node --experimental-strip-types scripts/windows-runtime-check.mts --strict",
    "setup:analysis": "node --experimental-strip-types scripts/setup-analysis.mts",
    "setup:analysis:dry-run": "node --experimental-strip-types scripts/setup-analysis.mts --dry-run",
    "start:local": "node --experimental-strip-types scripts/start-mashlab-local.mts",
    "start:local:windows": "node --experimental-strip-types scripts/start-local-windows.mts",
    "validate:analysis-lane": "node --experimental-strip-types scripts/validate-analysis-lane.mts",
    "collect:release-versions": "node --experimental-strip-types scripts/collect-release-versions.mts",
    "package:demo-release": "node --experimental-strip-types scripts/package-demo-release.mts",
    "capture:release-screenshots": "node --experimental-strip-types scripts/capture-release-screenshots.mts",
    "smoke:quick-mix": "node --experimental-strip-types scripts/quick-mix-smoke.mts",
    "smoke:quick-mix:browser": "node --experimental-strip-types scripts/quick-mix-browser-smoke.mts",
    "smoke:quick-mix:section-qa": "node --experimental-strip-types scripts/quick-mix-section-browser-qa.mts",
    "check:local-engine": "node --experimental-strip-types local-engine/check-binaries.mts",
    "check:python-service": "node --experimental-strip-types scripts/python-service-check.mts compile",
    "check:python-service:test": "node --experimental-strip-types scripts/python-service-check.mts test",
    "check:python-service:venv": "node --experimental-strip-types scripts/python-service-check.mts compile --venv",
    "check:python-service:test:venv": "node --experimental-strip-types scripts/python-service-check.mts test --venv"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
